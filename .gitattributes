# This repo is a single-page personal site. Undergraduate coursework that
# used to live here (C / JSP / Java) was split out to DannyJPark/undergrad-coursework,
# which is what was skewing language detection toward Java.
*.html linguist-detectable=true
*.html linguist-language=HTML

# Vendored / generated assets should not count toward language stats.
*.jpeg linguist-vendored
*.jpg  linguist-vendored
*.png  linguist-vendored
*.pdf  linguist-vendored

# Normalize line endings.
* text=auto eol=lf
*.jpeg binary
*.jpg  binary
*.png  binary
*.pdf  binary
